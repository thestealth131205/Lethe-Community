<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package-Sichtbarkeit (Android 11+) für die Companion-App „Lethe Media Player" –
         nötig, damit getLaunchIntentForPackage/getPackageInfo prüfen können, ob sie installiert ist. -->
    <queries>
        <package android:name="com.Lethe.mediaplayer" />
    </queries>

    <!-- WRITE_EXTERNAL_STORAGE nur für API < 29 nötig (Galerie-Export Movies/Pictures);
         ab Android 10 (Scoped Storage) wird per MediaStore geschrieben -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- NETZWERK -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GOOGLE PLAY BILLING (In-App-Käufe / Styx-Coins) -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- KAMERA & MIKROFON (Für Videoanrufe & Profilbilder) -->
    <uses-feature android:name="android.hardware.camera" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- STANDORT (Für Entfernungsmessung in der Liste) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Hintergrund-Standort: optional, für zuverlässiges Live-Standort-Teilen wenn die App
         nicht im Vordergrund ist. Lehnt der Nutzer ab, wird weiter der Foreground-Service genutzt. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Medien-Zugriff: READ_EXTERNAL_STORAGE nur für API < 33, darüber READ_MEDIA_* -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Benachrichtigungen (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Hintergrund-Services & Akku-Optimierung -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- WakeLock verhindert, dass der WebSocket-Service eingefroren wird -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Vollbild-Intent für eingehende Anrufe (Sperrbildschirm) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- APK-Installation aus externen Quellen (für In-App-Update) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Über anderen Apps anzeigen (schwebender Mini-Musik-Player) -->

    <!-- Telefonnummer lesen (für SIM-Nummern-Auslesen bei Registrierung + PhoneNumberExtractor) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- SMS senden (für Reverse-SMS-Verifikation – öffnet SMS-App, sendet nicht selbst) -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- FCM Remote-Messaging ForegroundService (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Listen-Together Audio-Wiedergabe ForegroundService (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Live-Standort Foreground Service (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Telefonbuch-Zugriff (für Kontakte importieren) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Kontakte-Integration: Lethe-RawContacts unter "Verbundene Apps" schreiben -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <!-- Bluetooth Audio-Routing (für BT-Kopfhörer/-Headsets bei Calls und Spark-Feed) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Bluetooth LE für P2P-Mesh-Discovery (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="31" />
    <!-- WiFi Direct für P2P-Mesh-Transport -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!--
        Konto-Brücke für die Companion-App „Lethe Medie Player":
        Signature-Permission → nur eine App mit IDENTISCHER Signatur (gleicher Keystore)
        darf über den AuthBridgeProvider die Session (JWT + userId) lesen.
    -->
    <permission
        android:name="com.Lethe.app.permission.AUTH_BRIDGE"
        android:protectionLevel="signature" />

    <application
        android:name=".SecureChatApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.SecureChat"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        tools:targetApi="31">

        <!-- Hinweis: usesCleartextTraffic="true" erlaubt HTTP (Port 8000).
             Ohne das blockiert Android alles, was nicht HTTPS ist. -->

        <!-- WorkManager: Standard-Initializer deaktivieren, damit Hilt eigene Factory nutzen kann -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Konto-Brücke: liefert JWT + userId nur an gleich-signierte Apps (Lethe Medie Player) -->
        <provider
            android:name=".AuthBridgeProvider"
            android:authorities="com.Lethe.app.authbridge"
            android:exported="true"
            android:readPermission="com.Lethe.app.permission.AUTH_BRIDGE" />

        <!-- FileProvider für Kamera-Fotos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Empfängt Inline-Reply aus Nachrichten-Benachrichtigungen -->
        <receiver
            android:name=".MessageReplyReceiver"
            android:exported="false" />

        <!-- Empfängt "Als gelesen markieren" aus Benachrichtigungen (Wear OS / Android Auto) -->
        <receiver
            android:name=".MarkAsReadReceiver"
            android:exported="false" />

        <!-- Startbildschirm-Widget: zeigt Avatar + Namen eines einzelnen Kontakts/einer Gruppe -->
        <receiver
            android:name=".widget.ContactWidgetProvider"
            android:exported="false"
            android:label="@string/widget_contact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/contact_widget_info" />
        </receiver>

        <!-- Widget-Konfiguration: Auswahl des Kontakts/der Gruppe beim Platzieren des Widgets -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.SecureChat">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Startet Hintergrund-Arbeit (WebSocket/Reconnect) nach Geräte-Neustart & App-Update neu -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- WebSocket Keepalive ForegroundService (Legacy – nicht mehr gestartet) -->
        <service
            android:name=".WebSocketKeepaliveService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- NotificationHandler: Keepalive + Liveness-Check + Fallback-Notification -->
        <!-- dataSync statt remoteMessaging: remoteMessaging erfordert FCM-Vorbedingung auf Android 14+ -->
        <!-- stopWithTask=false: Service läuft weiter, wenn die App aus den Recents gewischt wird
             (häufigster "Kill") → WebSocket bleibt verbunden, keine False-Positive-Benachrichtigung -->
        <service
            android:name=".NotificationHandler"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false"
            android:exported="false" />

        <!-- CallForegroundService: Hält Mikrofon/Kamera/Bildschirmfreigabe im Hintergrund aufrecht (Android 14+) -->
        <service
            android:name=".CallForegroundService"
            android:foregroundServiceType="microphone|camera|mediaProjection"
            android:exported="false" />

        <!-- VoiceRecordingService: Hält Mikrofon-Aufnahme auch bei Bildschirm-Dimming aufrecht (Android 14+) -->
        <service
            android:name=".VoiceRecordingService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- LiveLocationService: Kontinuierliches hochpräzises Standort-Tracking im Hintergrund -->
        <service
            android:name=".LiveLocationService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Eingebetteter Tor-Service (Wrapper um Guardian Project tor-android, kein Orbot erforderlich) -->
        <!-- TorServiceWrapper leitet startForeground() auf API 34+ korrekt mit Typ-Angabe weiter -->
        <service
            android:name=".TorServiceWrapper"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- FCM-Service (.LetheFcmService) liegt jetzt im playstore-Flavor
             (src/playstore/AndroidManifest.xml). Der foss/F-Droid-Build hat kein FCM. -->

        <!--
            Android Auto CarAppService: Stellt eine Messaging-Oberfläche im Auto bereit.
            Kategorie MESSAGING registriert Lethe als Messaging-App in Android Auto.
            Zeigt Konversationsliste mit Kontakt-Avataren, Bild-Thumbnails und AA-optimierten
            Vorschautexten (inkl. Sprachnachricht-Hinweise) direkt im Fahrzeugdisplay.
        -->
        <service
            android:name=".LetheCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.MESSAGING" />
            </intent-filter>
        </service>

        <!--
            Kontakte-Integration ("Verbundene Apps", wie WhatsApp).
            Authenticator stellt den Lethe-System-Account bereit; der Sync-Adapter
            bindet ihn an den Kontakte-Provider und liefert via CONTACTS_STRUCTURE
            die Darstellung der Aktionszeilen (res/xml/contacts.xml).
        -->
        <service
            android:name=".contacts.LetheAuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <service
            android:name=".contacts.LetheContactsSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_contacts" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/contacts" />
        </service>

        <!-- Brücken-Activity: Tap auf Lethe-Aktionszeile in der Kontakte-App → MainActivity -->
        <activity
            android:name=".contacts.ContactActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.com.Lethe.app.chat" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.com.Lethe.app.voicecall" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.com.Lethe.app.videocall" />
            </intent-filter>
        </activity>

        <!-- IncomingCallActivity: Sperrbildschirm-Anruf-UI (Videoanruf / Sprachanruf) -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.SecureChat"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SecureChat"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Text & URLs teilen (TikTok, YouTube, Instagram, Facebook etc.) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Bilder teilen -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- RAW-Fotos teilen (Nikon NEF/NRW, Canon CR2/CR3, Android DNG, Sony ARW, …) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/x-nikon-nef" />
                <data android:mimeType="image/x-nikon-nrw" />
                <data android:mimeType="image/x-canon-cr2" />
                <data android:mimeType="image/x-canon-cr3" />
                <data android:mimeType="image/x-adobe-dng" />
                <data android:mimeType="image/x-sony-arw" />
                <data android:mimeType="image/x-fuji-raf" />
                <data android:mimeType="image/x-olympus-orf" />
                <data android:mimeType="image/x-panasonic-rw2" />
                <data android:mimeType="image/x-pentax-pef" />
            </intent-filter>

            <!-- Videos teilen -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- Audio-Dateien teilen (MP3, WAV, WMA, OGG, FLAC, AAC, M4A …) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Dokumente und allgemeine Dateien teilen (PDF, ZIP, RAR, STL …) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>

            <!-- Octet-Stream Fallback (unbekannte Dateitypen, z. B. STL von manchen Datei-Managern) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Mehrere Dateien auf einmal teilen -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!--
                Google Assistant / Android Auto: "Hey Google, schreibe [Name] eine Lethe-Nachricht"
                =====================================================================================
                android.intent.category.APP_MESSAGING: Registriert Lethe im Android-Messaging-
                Ökosystem – Android Auto zeigt die App in der Messaging-Sektion, Assistant erkennt
                sie als Messaging-App für SEND_MESSAGE App Actions (shortcuts.xml).

                smsto-Scheme: Standard für messaging-App-Intents (SMS To), wird von Assistant und
                Auto für das Routing an Messaging-Apps genutzt.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_MESSAGING" />
                <data android:scheme="smsto" />
            </intent-filter>

            <!-- Direct Share: shortcuts.xml registriert Kontakt-Shortcuts im System-Share-Sheet -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Deep Link: lethe://add?token=TOKEN&u=FAKE_NUMBER (Einladungslink) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lethe" android:host="add" />
            </intent-filter>

            <!-- Deep Link: lethe://post?C={contentId} (interner Content-Link, Legacy) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lethe" android:host="post" />
            </intent-filter>

            <!-- Deep Link: lethe://sp?id={contentId} (Spark-Link) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lethe" android:host="sp" />
            </intent-filter>

            <!-- Deep Link: lethe://li?id={contentId} (Livestream-Link) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lethe" android:host="li" />
            </intent-filter>

            <!-- Deep Link: https://letheapp.de/invite.php?token=TOKEN (Web-Einladungslink) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="letheapp.de" android:pathPrefix="/invite.php" />
            </intent-filter>
        </activity>
    </application>

</manifest>