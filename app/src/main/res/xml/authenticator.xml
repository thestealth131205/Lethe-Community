<?xml version="1.0" encoding="utf-8"?>
<!--
    Account-Authenticator für die Lethe-Kontakte-Integration.
    Registriert einen System-Account vom Typ "com.Lethe.app", an den die
    Lethe-RawContacts gehängt werden. Dadurch erscheint Lethe – wie WhatsApp –
    unter "Verbundene Apps" in der Kontakte-App. Der Account dient nur als
    Container; es findet keine echte Server-Anmeldung über AccountManager statt.
-->
<account-authenticator xmlns:android="http://schemas.android.com/apk/res/android"
    android:accountType="com.Lethe.app"
    android:icon="@mipmap/ic_launcher"
    android:smallIcon="@mipmap/ic_launcher"
    android:label="@string/app_name" />
