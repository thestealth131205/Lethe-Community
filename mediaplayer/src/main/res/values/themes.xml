<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Minimal-Theme für die Compose-Activity (dunkel, ohne ActionBar).
         android:colorBackground MUSS opak sein: Der Cast-Geräteauswahl-Dialog
         (MediaRouteChooserDialogFragment) wird über den FragmentManager der Activity
         angezeigt und liest colorBackground aus DIESEM Activity-Theme (nicht aus dem
         ContextThemeWrapper des MediaRouteButton). Fehlt der Wert, ist er 0 (translucent)
         und MediaRouterThemeHelper.getControllerColor() crasht mit
         "background can not be translucent: #0". Gleicher Fix wie Theme.SecureChat.
         android:colorPrimary MUSS ebenfalls opak sein: getControllerColor() liest colorPrimary
         und crasht sonst in der nächsten Stufe (calculateContrast, background=#0). -->
    <style name="Theme.LetheMediaPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lethe_background</item>
        <item name="android:colorBackground">@color/lethe_background</item>
        <item name="android:colorPrimary">#FF1A1A2E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Theme für MediaRouteButton/-Dialoge: android:colorBackground MUSS opak sein,
         sonst crasht MediaRouterThemeHelper.getControllerColor() beim Kontrast-Berechnen
         (IllegalArgumentException "background can not be translucent"), siehe
         com.securechat.app Theme.SecureChat.MediaRouter für denselben Fix. -->
    <style name="Theme.LetheMediaPlayer.MediaRouter" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#FF1A1A2E</item>
        <item name="colorAccent">#FF6C63FF</item>
        <item name="android:colorBackground">#FFFFFFFF</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
